# Copy to .env and fill in:   cp .env.example .env
# .env is ignored by git. Never commit API keys.
# Every value can also be given as an environment variable (which wins over this file).
# Relative paths are relative to the repository root.

# ---------------------------------------------------------------------------------------------------------
# Vision-language model (VLM) used to read the typed task against the camera image
# ---------------------------------------------------------------------------------------------------------
# openai       any OpenAI-compatible chat-completions API with image input (examples below)
# anthropic    Claude API (needs an API key, billed per use)
# claude_code  the Claude Code CLI on a signed-in Claude subscription (no API key; run `claude` once to log in)
# none         no model: unambiguous tasks are decided from their wording alone
# Several, comma-separated (e.g. openai,claude_code): asked in parallel; their answers must agree.
VLM_PROVIDER=openai

# For VLM_PROVIDER=openai (the model must accept images):
VLM_API_BASE=https://api.openai.com/v1
VLM_MODEL=gpt-4o-mini
VLM_API_KEY=
#   OpenRouter:  VLM_API_BASE=https://openrouter.ai/api/v1                                 VLM_MODEL=<a vision model id>
#   Gemini:      VLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/     VLM_MODEL=gemini-2.5-flash
#   Ollama:      VLM_API_BASE=http://127.0.0.1:11434/v1   VLM_MODEL=qwen2.5vl:7b   (VLM_API_KEY empty)
#   Any local OpenAI-compatible router / vLLM / LM Studio: its /v1 address and model name.

# For VLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=
# VLM_MODEL=claude-haiku-4-5

# For VLM_PROVIDER=claude_code:
# VLM_CLAUDE_CODE_MODEL=sonnet        # or haiku (faster)

# Instead of VLM_API_KEY here, the key can be kept in its own file (one line, chmod 600):
# VLM_API_KEY_FILE=~/.config/dobot-pnp/vlm-key

# Time limits (seconds)
# VLM_DEADLINE_S=40
# VLM_ROUTE_TIMEOUT_S=25

# ---------------------------------------------------------------------------------------------------------
# Folders
# ---------------------------------------------------------------------------------------------------------
# Scene assets: stage3_dobot_gripper_test.usd, load_dobot.urdf, dobot_description.yaml (see assets/README.md)
DOBOT_ASSETS=assets
# Run data: output/ is created here (captures, VLM decisions, calibration, run log)
DOBOT_DATA=.

# Isaac Sim launcher (pip install of Isaac Sim 6.0 puts it in your virtual environment's bin/)
ISAACSIM_CMD=~/env_isaacsim/bin/isaacsim

# ---------------------------------------------------------------------------------------------------------
# Real robot (optional; see docs/REAL_ROBOT.md)
# ---------------------------------------------------------------------------------------------------------
# Python of the real-robot environment created by scripts/setup_real.sh
DOBOT_REAL_PY=~/dobot_real/venv/bin/python
# Phone camera (Android "IP Webcam"): written by scripts/setup_real.sh
DOBOT_PHONE_MODE=wifi
DOBOT_PHONE_URL=http://192.168.43.1:8080/shot.jpg
